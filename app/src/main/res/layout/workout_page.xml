<?xml version="1.0" encoding="utf-8"?>
<!-- Workout Page field, modelled on Garmin's workout screen.
     Text sizes and the two images (arc, graph) are sized in code from the field's pixel size.
     The weights here must match PageRenderer.Rows. The field is meant to fill the whole page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- Top: two layers on top of each other.
         Layer 1 (unchanged layout): arc, AVG | gap | MAX, target range.
         Layer 2: the 3s power number, in a taller band (68%) that reaches up into the empty
         space inside the arc's curve, so it can be bigger without moving anything else. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="40">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/arc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="26"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="56"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="22"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/label_avg" style="@style/Label" android:text="AVG" />
                    <TextView android:id="@+id/avg" style="@style/Value" android:text="--" />
                </LinearLayout>

                <!-- Gap where the power number sits (it's drawn by the layer above). -->
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="56" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="22"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/label_max" style="@style/Label" android:text="MAX" />
                    <TextView android:id="@+id/max" style="@style/Value" android:text="--" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/range"
                style="@style/Value"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="18"
                android:gravity="center"
                android:textStyle="normal"
                android:text="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="14" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="68"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/power"
                    style="@style/Value"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="56"
                    android:gravity="center"
                    android:text="--" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="18" />
        </LinearLayout>
    </FrameLayout>

    <ImageView
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#C8C8C8" />

    <!-- STEPS          6/14 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/label_steps"
            style="@style/Value"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:text="STEPS" />

        <TextView
            android:id="@+id/steps"
            style="@style/Value"
            android:gravity="end"
            android:text="--" />
    </LinearLayout>

    <!-- Workout profile with the ridden power trace -->
    <ImageView
        android:id="@+id/graph"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="16"
        android:scaleType="fitXY" />

    <!-- Current step: big time left, then the next step. The graph above shows progress. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="27"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="70"
            android:background="@drawable/row_current"
            android:orientation="horizontal">

            <ImageView android:id="@+id/bar_cur" style="@style/StepBar" />

            <!-- Time left; becomes "Press lap to start next interval" when a lap step is waiting. -->
            <TextView
                android:id="@+id/cur_time"
                style="@style/Value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="--" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="30"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/bar_n1" style="@style/StepBar" />

            <TextView
                android:id="@+id/n1_dur"
                style="@style/Value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="34"
                android:background="@drawable/time_box"
                android:gravity="center"
                android:text="" />

            <TextView
                android:id="@+id/n1_range"
                style="@style/Value"
                android:layout_width="0dp"
                android:layout_weight="66"
                android:ellipsize="end"
                android:gravity="center"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- Workout controls: back, start/pause, next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="10"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/CtlButton"
            android:contentDescription="Previous step"
            android:src="@drawable/ic_ctl_prev" />

        <ImageView
            android:id="@+id/btn_play"
            style="@style/CtlButton"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Start or pause"
            android:src="@drawable/ic_ctl_play" />

        <ImageView
            android:id="@+id/btn_next"
            style="@style/CtlButton"
            android:contentDescription="Next step"
            android:src="@drawable/ic_ctl_next" />
    </LinearLayout>
</LinearLayout>
