<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the post-workout summary. Added in code, once per interval. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView android:id="@+id/c_num" style="@style/Cell" android:layout_weight="9" android:gravity="start|center_vertical" />
    <TextView android:id="@+id/c_time" style="@style/Cell" android:layout_weight="21" />
    <TextView android:id="@+id/c_target" style="@style/Cell" android:layout_weight="22" android:textStyle="normal" />
    <TextView android:id="@+id/c_avg" style="@style/Cell" android:layout_weight="16" />
    <TextView android:id="@+id/c_np" style="@style/Cell" android:layout_weight="16" />
    <TextView android:id="@+id/c_max" style="@style/Cell" android:layout_weight="16" />
</LinearLayout>
